---
import Layout from '../layouts/Layout.astro';
import { LINKS } from '../data/site';
const title = 'Seferia Matrix — SurvivalTaktix';
const description =
  'A dice roguelike deckbuilder: lock & roll five dice to cast spells and build a deck of 300+ upgrades to explode your damage. Out now on Steam.';
---
<Layout title={title} description={description} ogImage="/images/seferia-header.jpg">
  <main data-accent="seferia">
    <!-- hero -->
    <section class="ghero">
      <div class="ghero-art" aria-hidden="true">
        <img src="/images/seferia-hero.jpg" alt="" />
      </div>
      <div class="container ghero-inner">
        <p class="eyebrow">Dice Roguelike Deckbuilder · PC · Steam</p>
        <h1 class="h1">Seferia Matrix</h1>
        <p class="blurb">
          Lock and roll five dice to cast spells, then stack upgrades until your
          damage breaks the scoreboard.
        </p>
        <div class="btn-row">
          <a class="btn btn--solid" href={LINKS.steam} target="_blank" rel="noopener">Buy on Steam</a>
          <a class="btn btn--ghost" href={LINKS.trailer} target="_blank" rel="noopener">Watch Trailer</a>
        </div>
      </div>
    </section>

    <!-- trailer -->
    <section class="section">
      <div class="container">
        <p class="eyebrow reveal">Trailer</p>
        <div class="frame reveal">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${LINKS.trailerId}`}
            title="Seferia Matrix — Trailer"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- features -->
    <section class="section--tight">
      <div class="container">
        <p class="eyebrow reveal">How it plays</p>
        <h2 class="h2 measure reveal">Lock &amp; Roll five dice. Explode your damage.</h2>
        <div class="features" style="margin-top: 3rem;">
          <div class="feature reveal"><h3>Roll the dice to cast your spells</h3><p>Lock &amp; Roll your dice to build the hand that casts the spell you want.</p></div>
          <div class="feature reveal" data-delay="1"><h3>Artifacts &amp; Sigils</h3><p>Mix and match over 100 Artifacts to customize a mage that's entirely your own, and use dozens of Sigils to turn the tables at will.</p></div>
          <div class="feature reveal" data-delay="2"><h3>Three Schools, two kinds of Mage</h3><p>From Mages who fight with spells to Battle Mages who blend close combat with magic, forge your own path across six modes.</p></div>
        </div>
      </div>
    </section>

    <!-- gallery -->
    <section class="section--tight">
      <div class="container">
        <p class="eyebrow reveal">Screens</p>
        <div class="gallery-land reveal">
          <figure><img src="/images/seferia-shot-1.jpg" alt="Seferia Matrix screenshot 1" loading="lazy" /></figure>
          <figure><img src="/images/seferia-shot-2.jpg" alt="Seferia Matrix screenshot 2" loading="lazy" /></figure>
          <figure><img src="/images/seferia-shot-3.jpg" alt="Seferia Matrix screenshot 3" loading="lazy" /></figure>
          <figure><img src="/images/seferia-shot-4.jpg" alt="Seferia Matrix screenshot 4" loading="lazy" /></figure>
          <figure><img src="/images/seferia-shot-5.jpg" alt="Seferia Matrix screenshot 5" loading="lazy" /></figure>
          <figure><img src="/images/seferia-shot-6.jpg" alt="Seferia Matrix screenshot 6" loading="lazy" /></figure>
        </div>
      </div>
    </section>

    <!-- press -->
    <section class="section" id="press">
      <div class="container">
        <p class="eyebrow reveal">Press</p>
        <div class="fact reveal">
          <div class="fact-head">
            <div class="sub">PC · Steam</div>
            <h3>Seferia Matrix — Fact Sheet</h3>
          </div>
          <dl>
            <div class="row"><dt>Genre</dt><dd>Dice roguelike deckbuilder</dd></div>
            <div class="row"><dt>Platform</dt><dd>PC (Steam)</dd></div>
            <div class="row"><dt>Release</dt><dd>November 9, 2026 · Out now</dd></div>
            <div class="row"><dt>Languages</dt><dd>English, Korean, Japanese, Simplified &amp; Traditional Chinese, French, German, Spanish (Spain &amp; Latin America), Russian, Portuguese (Brazil)</dd></div>
            <div class="row"><dt>Developer</dt><dd>SurvivalTaktix</dd></div>
            <div class="row"><dt>Links</dt><dd>
              <a href={LINKS.steam} target="_blank" rel="noopener">Steam</a> ·
              <a href={LINKS.steamDemo} target="_blank" rel="noopener">Demo</a> ·
              <a href={LINKS.trailer} target="_blank" rel="noopener">Trailer</a>
            </dd></div>
          </dl>
        </div>
        <p class="body-dim press-note reveal">
          Key art, screenshots, the trailer, and store text are in the press kit.
          There's no embargo on published material.
        </p>
        <div class="btn-row reveal">
          <a class="btn btn--solid" href={LINKS.pressKit} target="_blank" rel="noopener">Download Press Kit</a>
          <a class="btn btn--ghost" href={`mailto:${LINKS.email}?subject=${encodeURIComponent('[Media Inquiry] Seferia Matrix')}`}>Press Contact</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
