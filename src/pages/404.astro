---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found — SurvivalTaktix" description="This page doesn't exist.">
  <main>
    <section class="section contact">
      <div class="container">
        <p class="eyebrow">404</p>
        <h1 class="display">Lost the<br /><span class="accent-text">trail.</span></h1>
        <p class="body-dim contact-copy">This page doesn't exist or has moved.</p>
        <div class="btn-row">
          <a class="btn btn--solid" href="/">Back to Home</a>
          <a class="btn btn--ghost" href="/contact">Contact</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
