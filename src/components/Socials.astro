---
import { SOCIALS } from '../data/site';
const { size = 'sm' } = Astro.props;
---
<ul class={`socials socials--${size}`}>
  {SOCIALS.map((s) => (
    <li>
      <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
        <span class="socials-icon" style={`--icon: url(${s.icon})`}></span>
      </a>
    </li>
  ))}
</ul>
