---
import { NAV } from '../data/site';
import Socials from './Socials.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header" id="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label="SurvivalTaktix home"><img class="brand-logo" src="/images/logo-stx.png" alt="SurvivalTaktix" width="480" height="325" /></a>
    <nav class="nav" aria-label="Primary">
      {NAV.map((item) => {
        const href = item.href.replace(/\/$/, '') || '/';
        const current = href === path;
        return (
          <a href={item.href} aria-current={current ? 'page' : undefined}>{item.label}</a>
        );
      })}
    </nav>
    <div class="header-socials"><Socials /></div>
  </div>
</header>
